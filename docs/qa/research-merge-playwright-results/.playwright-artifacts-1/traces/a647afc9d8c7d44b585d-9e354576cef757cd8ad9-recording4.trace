: 50px; object-fit: contain; }\n.admin-product-name small { color: #72686b; }\n.admin-editor { display: grid; gap: 17px; max-width: 790px; }\n.admin-editor-top { display: flex; align-items: center; gap: 20px; }\n.admin-editor-top img { width: 100px; height: 110px; object-fit: contain; }\n.admin-checks { display: flex; flex-wrap: wrap; gap: 20px; }\n.admin-checks label { flex-direction: row; align-items: center; }\n.admin-editor .button-primary { justify-self: start; }\n.catalog-admin-filters { flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 8px; }\n.catalog-admin-filters input { flex: 1 1 220px; }\n.catalog-admin-filters select, .admin-bulk-toolbar select, .admin-bulk-toolbar input:not([type=checkbox]) { min-height: 40px; padding: 0 10px; border: 1px solid var(--line); background: #fff; }\n.catalog-admin-filters span { margin-left: auto; color: #756d70; font-size: 12px; }\n.admin-bulk-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }\n.admin-bulk-toolbar > label { display: flex; flex-direction: row; align-items: center; gap: 7px; font-size: 12px; }\n.admin-bulk-toolbar > span { color: #756d70; font-size: 11px; }\n.admin-bulk-toolbar .button-primary { min-height: 38px; }\n.admin-bulk-toolbar p { flex-basis: 100%; margin: 0; }\n.catalog-state { display: inline-flex; white-space: nowrap; padding: 5px 8px; border: 1px solid #e4d9d9; border-radius: 3px; color: #65595b; background: #fbf8f6; font-size: 10px; }\n.catalog-stock-out_of_stock, .catalog-verify-needs_review { color: #883d50; border-color: #e8c6cf; background: #fff2f4; }\n.catalog-stock-low_stock, .catalog-verify-partial { color: #825f2d; border-color: #e9ddc7; background: #fff9eb; }\n.catalog-stock-in_stock, .catalog-verify-verified, .catalog-publication-published { color: #426a4e; border-color: #d1e1d2; background: #f2faf3; }\n.catalog-publication-draft, .catalog-publication-archived, .catalog-verify-unverified { color: #6b6264; }\n.admin-product-section { display: grid; gap: 14px; padding: 19px; border: 1px solid var(--line); background: #fffdfa; }\n.admin-product-section h2 { margin: 0; }\n.admin-product-section .form-grid { margin: 0; }\n.admin-image-gallery { display: flex; flex-wrap: wrap; gap: 12px; }\n.admin-image-gallery figure { width: 110px; margin: 0; }\n.admin-image-gallery img { width: 110px; height: 120px; object-fit: contain; border: 1px solid var(--line); background: white; }\n.admin-image-gallery figcaption { padding-top: 4px; color: #71676a; font-size: 10px; }\n\n@media (max-width: 1100px) {\n  .header-main { height: 130px; grid-template-columns: 170px minmax(220px, 1fr) 210px; }\n  .logo-link { width: 165px; }\n  .collection-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .checkout-layout { grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; }\n  .routine-band { grid-template-columns: repeat(4, 1fr); }\n}\n@media (max-width: 760px) {\n  .header-main { height: 83px; }\n  .logo-link { width: 105px; }\n  .primary-nav { display: none; }\n  .site-header { padding-bottom: 1px; }\n  .mobile-drawer { overflow-y: auto; }\n  .mobile-tabbar a { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #544c4e; font-size: 8px; }\n  .mobile-tabbar a.active { color: var(--rose); }\n  .home-discovery, .promo-band, .related-products { padding: 25px 16px; }\n  .home-discovery .section-heading h2 { font-size: 24px; }\n  .discovery-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 5px; }\n  .discovery-tile { flex: 0 0 42%; min-height: 88px; scroll-snap-align: start; font-size: 15px; }\n  .promo-band { display: block; }\n  .promo-band h2 { font-size: 23px; margin-bottom: 16px; }\n  .routine-band { display: flex; flex-direction: column; align-items: stretch; gap: 0; }\n  .routine-intro { padding-bottom: 17px; }\n  .routine-step, .routine-step:nth-of-type(3), .routine-step:nth-of-type(4) { min-height: 65px; padding: 8px 0; border-left: 0; border-top: 1px solid #d8c5c8; }\n  .routine-cta { grid-column: auto; grid-row: auto; margin-top: 12px; }\n  .inner-page { padding: 25px 15px 90px; }\n  .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }\n  .directory-card { min-height: 95px; padding: 14px; }\n  .directory-card > span { font-size: 16px; }\n  .collection-layout { display: block; }\n  .filter-toggle { display: inline-flex; }\n  .filter-panel { display: none; margin-bottom: 20px; }\n  .filter-panel.open { display: block; }\n  .filter-panel .filters { padding: 18px; border: 1px solid var(--line); background: white; }\n  .collection-grid, .skeleton-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .collection-grid .product-card:last-of-type:nth-child(odd) { grid-column: auto; }\n  .pdp-layout, .product-details, .cart-page-layout, .checkout-layout, .info-grid, .admin-detail-grid { grid-template-columns: 1fr; }\n  .pdp-image, .pdp-image img { height: 380px; min-height: 0; }\n  .pdp-info { padding: 5px 0; }\n  .pdp-info h1 { font-size: 29px; }\n  .product-details { margin: 30px 0; }\n  .pdp-promises { flex-direction: column; gap: 10px; }\n  .cart-page-line { grid-template-columns: 75px minmax(0, 1fr); }\n  .cart-page-line img { width: 75px; height: 95px; }\n  .cart-page-line > div:last-child { grid-column: 2; display: flex; align-items: center; justify-content: space-between; }\n  .checkout-summary { position: static; grid-row: 1; }\n  .checkout-page-form { grid-row: 2; }\n  .checkout-layout { display: flex; flex-direction: column-reverse; }\n  .checkout-layout > * { width: 100%; }\n  .form-section { padding: 20px 16px; }\n  .form-grid { gap: 12px; }\n  .receipt-card { padding: 16px; }\n  .full-footer { padding: 30px 16px 88px; }\n  .site-footer > .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 15px; padding: 0; }\n  .footer-main > div:first-child { grid-column: 1 / -1; }\n  .site-footer > .footer-bottom { flex-direction: column; gap: 7px; padding-top: 16px; }\n  .admin-shell { display: block; }\n  .admin-sidebar { padding: 14px; }\n  .admin-logo { margin-bottom: 10px; }\n  .admin-sidebar nav { display: flex; flex-direction: row; overflow-x: auto; }\n  .admin-sidebar nav a { white-space: nowrap; }\n  .admin-store-link { display: none; }\n  .admin-content { padding: 20px 14px 90px; }\n  .admin-stats { grid-template-columns: repeat(2, 1fr); }\n  .admin-stats strong { font-size: 21px; }\n}\n@media (max-width: 420px) {\n  .directory-grid { grid-template-columns: 1fr 1fr; }\n  .discovery-tile { flex-basis: 58%; }\n  .form-grid { grid-template-columns: 1fr; }\n  .form-grid .full-field { grid-column: 1; }\n  .order-list-item { grid-template-columns: 1fr auto; }\n  .order-list-item span { grid-column: 1; }\n  .checkout-layout { gap: 15px; }\n  .cart-line { grid-template-columns: 70px 1fr auto; gap: 7px; }\n  .cart-line > a:first-child img { width: 70px; }\n}\n\n/* Information architecture V2 */\n.primary-nav .promo-link { color: var(--rose); }\n.mobile-search-toggle, .mobile-search-head { display: none; }\n\n.gallery-entry, .home-guided { max-width: var(--container); margin: auto; padding: 45px 3.3%; }\n.gallery-entry .section-heading h2, .home-guided .section-heading h2 { font-family: var(--serif); font-size: 31px; font-weight: 500; }\n.gallery-entry-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }\n.gallery-entry-card { min-height: 205px; display: flex; flex-direction: column; justify-content: space-between; padding: 22px; border: 1px solid #e7dcd9; background: linear-gradient(145deg, #fffdfa, #f8eeec); transition: transform .18s, border-color .18s; }\n.gallery-entry-card:nth-child(2) { background: linear-gradient(145deg, #fffdfa, #f2ece5); }\n.gallery-entry-card:hover { transform: translateY(-3px); border-color: #cca4af; }\n.entry-number { color: var(--rose); font-family: var(--serif); font-size: 16px; }\n.gallery-entry-card h3 { margin: 10px 0 4px; font-family: var(--serif); font-size: 23px; font-weight: 500; }\n.gallery-entry-card p { margin: 0; color: #6e6568; font-size: 12px; }\n.entry-action, .home-guided-card > span { display: flex; align-items: center; gap: 8px; color: var(--rose); font-size: 11px; font-weight: 700; }\n.home-guided-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.home-guided-card { min-height: 172px; display: flex; flex-direction: column; align-items: flex-start; padding: 20px; background: #fffdfa; border: 1px solid var(--line); }\n.home-guided-card > svg { color: var(--rose); }\n.home-guided-card h3 { margin: 12px 0 5px; font-family: var(--serif); font-size: 19px; font-weight: 500; }\n.home-guided-card p { margin: 0; color: #6b6265; font-size: 11px; line-height: 1.5; }\n.home-guided-card > span { margin-top: auto; padding-top: 15px; }\n.home-pack-card { background: #f7e9eb; }\n.skin-discovery .discovery-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n\n.directory-section { margin: 32px 0 48px; }\n.directory-section > h2 { margin: 0 0 16px; font-family: var(--serif); font-size: 27px; font-weight: 500; }\n.directory-section .directory-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n.quick-pills { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 13px; scrollbar-width: thin; }\n.quick-pills button { flex: 0 0 auto; min-height: 34px; border: 1px solid #ded6d2; border-radius: 30px; padding: 6px 14px; background: #fffdfa; cursor: pointer; font-size: 11px; }\n.quick-pills button.active, .quick-pills button:hover { border-color: var(--rose); background: #f8eaee; color: #87475a; }\n.filter-head { display: flex; justify-content: space-between; align-items: center; }\n.filter-head button { display: none; border: 0; background: transparent; cursor: pointer; }\n.filter-section { border-bottom: 1px solid var(--line); padding: 11px 0; }\n.filter-section summary { cursor: pointer; font-size: 12px; font-weight: 700; }\n.facet-options { display: grid; gap: 3px; margin-top: 10px; }\n.facet-options button { display: flex; justify-content: space-between; gap: 10px; width: 100%; border: 0; padding: 7px 6px; background: transparent; text-align: left; cursor: pointer; font-size: 11px; }\n.facet-options button.selected, .facet-options button:hover { background: #f9ebee; color: #8c4358; }\n.facet-options small { color: #81777a; }\n.price-filter { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 11px; }\n.price-filter label { display: grid; gap: 4px; font-size: 10px; }\n.price-filter input { width: 100%; min-width: 0; height: 36px; padding: 6px; border: 1px solid var(--line); }\n.price-filter button { grid-column: 1 / -1; min-height: 32px; border: 1px solid var(--rose); background: #fff; color: var(--rose); cursor: pointer; }\n.filter-clear { margin-top: 8px; border: 0; background: transparent; cursor: pointer; }\n.filter-apply { display: none; }\n.selected-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin: 0 0 18px; }\n.selected-filters button { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 4px 9px; border: 1px solid #d8bec5; border-radius: 20px; background: #faedf0; cursor: pointer; font-size: 10px; }\n.selected-filters .clear-all { border-color: transparent; background: transparent; text-decoration: underline; }\n.pagination { display: flex; justify-content: center; align-items: center; gap: 18px; margin: 30px 0; font-size: 12px; }\n.pagination a { color: var(--rose); font-weight: 700; }\n\n.guided-step { border-top: 1px solid var(--line); padding: 28px 0 36px; }\n.guided-step-head { display: flex; align-items: flex-start; gap: 19px; margin-bottom: 21px; }\n.guided-step-head > span { display: grid; place-items: center; width: 38px; height: 38px; flex: 0 0 auto; border-radius: 50%; background: var(--rose); color: white; font-family: var(--serif); }\n.guided-step-head h2 { margin: 0 0 6px; font-family: var(--serif); font-size: 25px; font-weight: 500; }\n.guided-step-head p { margin: 0 0 9px; color: #6c6264; font-size: 12px; }\n.guided-products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.routine-select { width: 100%; min-height: 35px; margin-bottom: 6px; display: flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid #d4bdc3; background: #fff; color: var(--rose); cursor: pointer; font-size: 11px; }\n.routine-select.selected { background: var(--rose); color: white; }\n.routine-selection-bar { position: sticky; bottom: 0; z-index: 3; display: flex; justify-content: space-between; align-items: center; gap: 15px; padding: 15px 20px; border: 1px solid var(--line); background: #fffdfa; box-shadow: 0 -8px 20px #2825260e; font-size: 12px; }\n.pack-components { margin-top: 54px; }\n.pack-components h2 { font-family: var(--serif); font-size: 27px; font-weight: 500; }\n.pack-component-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.pack-component { display: grid; grid-template-columns: 82px 1fr 20px; align-items: center; gap: 13px; padding: 12px; border: 1px solid var(--line); background: white; }\n.pack-component img { width: 82px; height: 90px; object-fit: contain; }\n.pack-component span { display: grid; gap: 5px; }\n.pack-component small { color: var(--rose); }\n.pack-component strong { font-size: 12px; font-weight: 600; }\n.pack-component em { color: #736b6c; font-size: 10px; font-style: normal; }\n.advice-article { max-width: 880px; }\n.article-body { padding-top: 20px; border-top: 1px solid var(--line); }\n.article-body p { margin: 0 0 19px; color: #4f484a; font-size: 14px; line-height: 1.8; white-space: pre-line; }\n.admin-nav-group { display: flex; flex-direction: column; margin-bottom: 18px; }\n.admin-nav-group h2 { margin: 0 10px 5px; color: #95888c; font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }\n.admin-sidebar nav .admin-nav-group a { display: block; }\n.admin-taxonomy-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }\n.admin-taxonomy-checks { display: flex; flex-direction: column; gap: 9px; min-width: 0; padding: 14px; border: 1px solid var(--line); }\n.admin-taxonomy-checks legend { padding: 0 5px; font-size: 12px; font-weight: 700; }\n.admin-taxonomy-checks label, .admin-verify { display: flex !important; flex-direction: row !important; align-items: center; gap: 8px; font-size: 11px; font-weight: 400; }\n.admin-editor .admin-taxonomy-checks input, .admin-editor .admin-verify input { width: auto; min-height: auto; }\n.admin-subform { margin-top: 22px; }\n.admin-subform h3 { margin: 7px 0 0; font-family: var(--serif); font-size: 20px; font-weight: 500; }\n.admin-component-row { display: grid; grid-template-columns: 1fr 80px auto; gap: 9px; }\n.admin-component-row select, .admin-component-row input { min-width: 0; }\n.admin-component-row button, .admin-step-editor button { border: 0; background: transparent; color: var(--rose); cursor: pointer; font-size: 11px; }\n.admin-step-editor { display: grid; gap: 12px; padding: 15px; border: 1px solid var(--line); background: #fdfbf9; }\n.admin-step-editor strong { font-size: 12px; }\n.admin-step-editor select[multiple] { min-height: 120px; }\n\n@media (max-width: 760px) {\n  .header-actions .header-action:not(:last-child) { display: none; }\n  .mobile-search-toggle { display: grid; place-items: center; width: 38px; height: 40px; border: 0; background: transparent; cursor: pointer; }\n  .mobile-search { position: fixed; inset: 0; z-index: 40; width: 100%; height: 100dvh; display: block; margin: 0; padding: 17px 15px; border: 0; border-radius: 0; background: #fffdfa; overflow-y: auto; }\n  .mobile-search-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 19px; font-family: var(--serif); font-size: 19px; }\n  .mobile-search-head button { border: 0; background: transparent; cursor: pointer; }\n  .mobile-search > .search-icon { position: absolute; top: 77px; left: 14px; }\n  .mobile-search input { display: block; width: 100%; height: 48px; padding: 0 44px; border: 1px solid var(--line); border-radius: 4px; }\n  .mobile-search .search-clear { position: absolute; top: 78px; right: 22px; }\n  .mobile-search .search-popover { position: static; width: 100%; max-height: none; margin-top: 12px; border: 0; box-shadow: none; }\n  .mobile-search .search-popover button { min-height: 45px; }\n  .gallery-entry, .home-guided { padding: 30px 16px; }\n  .gallery-entry .section-heading h2, .home-guided .section-heading h2 { font-size: 26px; }\n  .gallery-entry-grid { grid-template-columns: 1fr; gap: 9px; }\n  .gallery-entry-card { min-height: 130px; padding: 16px; }\n  .gallery-entry-card h3 { margin: 0 0 4px; font-size: 19px; }\n  .home-guided-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }\n  .home-guided-card { flex: 0 0 70%; scroll-snap-align: start; }\n  .directory-section .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .collection-toolbar { flex-wrap: wrap; }\n  .collection-toolbar label { margin-left: 0; }\n  .filter-panel, .filter-panel.open { position: fixed; inset: 0; z-index: 35; margin: 0; background: #fffdfa; overflow-y: auto; }\n  .filter-panel { display: none; }\n  .filter-panel.open { display: block; }\n  .filter-panel .filters { min-height: 100%; display: block; padding: 20px 18px 85px; border: 0; }\n  .filter-head button { display: inline-flex; }\n  .filter-section { padding: 16px 0; }\n  .filter-apply { position: fixed; right: 0; bottom: 0; left: 0; width: 100%; display: flex; justify-content: center; min-height: 62px; }\n  .guided-products { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .routine-selection-bar { bottom: 61px; padding: 10px; }\n  .routine-selection-bar .button-primary { font-size: 10px; }\n  .pack-component-grid { grid-template-columns: 1fr; }\n  .admin-sidebar nav .admin-nav-group { display: flex; flex-direction: row; align-items: center; gap: 4px; margin: 0; }\n  .admin-nav-group h2 { white-space: nowrap; margin: 0 4px; }\n  .admin-taxonomy-grid { grid-template-columns: 1fr; }\n  .admin-component-row { grid-template-columns: 1fr 65px auto; }\n  .admin-content { padding: 22px 14px; }\n  .admin-bulk-toolbar { padding: 14px; }\n  .admin-bulk-toolbar > * { flex: 1 1 100%; }\n  .admin-bulk-toolbar > label { flex: 1 1 auto; }\n  .catalog-admin-filters > input, .catalog-admin-filters > select { width: 100%; max-width: none; flex: 1 1 100%; }\n  .catalog-admin-filters span { margin-left: 0; }\n  .admin-product-section { padding: 14px; }\n}\n\n@media (max-width: 430px) {\n  .directory-section .directory-grid { grid-template-columns: 1fr 1fr; }\n  .home-guided-card { flex-basis: 82%; }\n  .gallery-entry-card { min-height: 135px; }\n}\n.pdp-thumbnails { display: flex; gap: 10px; margin-top: 14px; overflow-x: auto; }\n.pdp-thumbnails button { flex: 0 0 76px; height: 84px; padding: 4px; border: 1px solid var(--line, #e7ddda); background: #fff; }\n.pdp-thumbnails button[aria-pressed=\"true\"] { border-color: var(--rose, #aa5368); }\n.pdp-thumbnails img { width: 100%; height: 100%; object-fit: contain; }\n"],["STYLE",{},"/* Compact Gallery commerce header. Other storefront sections keep their styles. */\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 40;\n  background: var(--gallery-white);\n  box-shadow: 0 1px 0 #2825260b;\n  padding-bottom: 0;\n}\n.header-main {\n  width: 100%;\n  max-width: 1440px;\n  height: 64px;\n  margin: 0 auto;\n  padding: 0 clamp(22px, 4.1vw, 62px);\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(280px, min(50vw, 620px)) minmax(0, 1fr);\n  gap: clamp(15px, 2.4vw, 34px);\n  align-items: center;\n}\n.logo-link { position: relative; width: 128px; height: 64px; overflow: hidden; }\n.brand-logo { position: absolute; top: -16px; left: 0; width: 128px; max-width: none; height: auto; }\n.header-main > .search-wrap {\n  width: 100%;\n  max-width: 620px;\n  height: 43px;\n  margin: auto;\n  background: #fffdfa;\n  border-color: #ddd6d3;\n  transition: border-color 200ms cubic-bezier(.2,.8,.2,1), box-shadow 200ms cubic-bezier(.2,.8,.2,1);\n}\n.header-main > .search-wrap:focus-within { border-color: var(--rose); box-shadow: 0 0 0 3px #a7546b17; }\n.search-wrap input { font-size: 12px; }\n.search-popover { z-index: 35; background: var(--gallery-white); border-color: #ded6d3; box-shadow: 0 12px 28px #28252618; }\n.search-popover .search-all-results { flex-direction: row; align-items: center; justify-content: space-between; color: var(--rose); font-weight: 700; }\n.header-actions { height: auto; justify-content: flex-end; gap: clamp(8px, 1.7vw, 22px); }\n.header-action {\n  width: auto;\n  min-width: 0;\n  height: 40px;\n  padding: 0 2px;\n  display: inline-flex;\n  flex-direction: row;\n  gap: 7px;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 500;\n  transition: color 150ms cubic-bezier(.2,.8,.2,1);\n}\n.header-action:hover { color: var(--rose); }\n.header-action > small { top: 2px; right: -8px; width: 15px; height: 15px; font-size: 8px; }\n.bag-wrap small { top: -8px; right: -9px; width: 15px; height: 15px; font-size: 8px; }\n.mobile-search-toggle { display: none; }\n.primary-nav {\n  width: 100%;\n  max-width: 1440px;\n  min-height: 38px;\n  height: 38px;\n  margin: auto;\n  padding: 0 22px;\n  gap: clamp(19px, 3vw, 42px);\n  align-items: center;\n  justify-content: center;\n}\n.primary-nav a {\n  position: relative;\n  height: 100%;\n  display: inline-flex;\n  align-items: center;\n  padding: 0;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: .025em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.primary-nav a::after {\n  bottom: 3px;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  transform: scaleX(0);\n  transform-origin: center;\n  transition: transform 180ms cubic-bezier(.2,.8,.2,1);\n}\n.primary-nav a:hover::after, .primary-nav a.active::after { width: 100%; transform: scaleX(1); }\n.trust-marquee {\n  height: 30px;\n  max-height: 30px;\n  overflow: hidden;\n  background: #efcfd8;\n  color: #614a50;\n}\n.trust-scroller {\n  width: max-content;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  animation: gallery-trust-marquee 34s linear infinite;\n}\n.trust-track {\n  --trust-gap: clamp(18px, 2.5vw, 34px);\n  flex: 0 0 auto;\n  min-width: 100vw;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  gap: var(--trust-gap);\n  padding-inline: calc(var(--trust-gap) / 2);\n  box-sizing: border-box;\n}\n.trust-marquee:hover .trust-scroller { animation-play-state: paused; }\n.trust-item { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: 10px; font-weight: 500; }\n.trust-item svg { flex: 0 0 auto; color: #a7546b; }\n.trust-sparkle { flex: 0 0 auto; color: #b47788; font-size: 10px; }\n.trust-mobile-copy { display: none; }\n@keyframes gallery-trust-marquee { to { transform: translateX(-50%); } }\n.site-header.is-scrolled { box-shadow: 0 6px 20px #28252614; }\n.overlay { z-index: 80; }\n\n@media (max-width: 1160px) {\n  .header-main { padding-inline: 28px; gap: 18px; }\n  .logo-link { width: 128px; }\n  .brand-logo { width: 128px; top: -16px; }\n  .header-action > span:not(.bag-wrap) { display: none; }\n  .header-actions { gap: 11px; }\n  .header-action { width: 34px; }\n  .primary-nav { gap: clamp(17px, 2.7vw, 32px); }\n}\n\n@media (max-width: 760px) {\n  .header-main {\n    height: 54px;\n    display: grid;\n    grid-template-columns: 76px minmax(0, 1fr) 76px;\n    gap: 0;\n    padding: 0 13px;\n  }\n  .mobile-menu-toggle { display: grid; width: 36px; height: 42px; justify-self: start; place-items: center; }\n  .logo-link { width: 108px; height: 54px; justify-self: center; }\n  .brand-logo { width: 108px; top: -14px; }\n  .header-main > .search-wrap { display: none; }\n  .header-actions { width: 76px; gap: 0; justify-content: space-between; }\n  .header-actions .header-action:not(:last-child) { display: none; }\n  .header-action { width: 36px; height: 40px; padding: 0; }\n  .mobile-search-toggle { display: grid; width: 36px; height: 40px; padding: 0; place-items: center; border: 0; background: transparent; }\n  .primary-nav { display: none; }\n  .trust-marquee { height: 28px; max-height: 28px; }\n  .trust-scroller, .trust-track { height: 28px; }\n  .trust-item { gap: 5px; font-size: 9px; }\n  .trust-item svg { width: 13px; height: 13px; }\n  .trust-track { --trust-gap: 15px; }\n  .trust-desktop-copy { display: none; }\n  .trust-mobile-copy { display: inline; }\n  .filter-panel, .filter-panel.open { z-index: 70; }\n  .mobile-search {\n    position: fixed;\n    inset: 0;\n    z-index: 90;\n    display: block;\n    width: 100%;\n    height: 100dvh;\n    margin: 0;\n    padding: 16px 16px 30px;\n    overflow-y: auto;\n    border: 0;\n    border-radius: 0;\n    background: var(--gallery-white);\n  }\n  .mobile-search:focus-within { border: 0; box-shadow: none; }\n  .mobile-search-head { display: flex; justify-content: flex-start; gap: 13px; align-items: center; height: 32px; margin: 0; font-size: 18px; }\n  .mobile-search-head button { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; }\n  .mobile-search > .search-icon { position: absolute; top: 74px; left: 17px; width: 18px; height: 18px; margin: 0; }\n  .mobile-search input { display: block; width: 100%; height: 46px; margin-top: 16px; padding: 0 42px; border: 1px solid #ded6d3; border-radius: 4px; font-size: 13px; }\n  .mobile-search input:focus { border-color: var(--rose); box-shadow: 0 0 0 3px #a7546b17; }\n  .mobile-search .search-clear { position: absolute; top: 74px; right: 22px; }\n  .mobile-search .search-popover { position: static; width: 100%; max-height: none; margin-top: 12px; padding: 0 2px; border: 0; box-shadow: none; }\n  .mobile-search .search-popover button { min-height: 45px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .trust-scroller { animation: none; }\n  .trust-track[aria-hidden='true'] { display: none; }\n  .trust-track { --trust-gap: 9px; }\n  .site-header *, .site-header *::before, .site-header *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }\n}\n@media (max-width: 760px) and (prefers-reduced-motion: reduce) {\n  .trust-track { --trust-gap: 6px; }\n  .trust-item { gap: 3px; font-size: 8px; }\n  .trust-item svg { width: 11px; height: 11px; }\n  .trust-sparkle { font-size: 8px; }\n}\n"],["STYLE",{},"/* Primary navigation panels share a shell, while each category keeps its own layout. */\n.gallery-nav-system { position: relative; z-index: 45; }\n.gallery-nav { gap: clamp(17px, 2.5vw, 38px); }\n.gallery-nav-item { height: 100%; display: inline-flex; align-items: center; gap: 5px; }\n.gallery-nav-item > a { flex: 0 0 auto; }\n.gallery-nav-item.is-open > a { color: var(--rose); }\n.gallery-nav-item.is-open > a::after { transform: scaleX(1); }\n.gallery-nav-chevron {\n  width: 16px;\n  height: 26px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: var(--ink);\n  cursor: pointer;\n}\n.gallery-nav-chevron svg { opacity: .55; transition: opacity 140ms ease, transform 140ms cubic-bezier(.2,.8,.2,1); }\n.gallery-nav-item:hover .gallery-nav-chevron svg, .gallery-nav-chevron:focus-visible svg { opacity: 1; }\n.gallery-nav-item.is-open .gallery-nav-chevron svg { opacity: 1; transform: rotate(180deg); }\n.gallery-nav-chevron:focus-visible { outline: 2px solid var(--rose); outline-offset: 2px; }\n\n.gallery-mega {\n  position: absolute;\n  top: 100%;\n  left: 50%;\n  z-index: 45;\n  width: min(1060px, calc(100vw - 36px));\n  max-height: calc(100dvh - 142px);\n  overflow-y: auto;\n  padding: 26px 34px 28px;\n  border: 1px solid #e9e0dc;\n  border-radius: 0 0 3px 3px;\n  background: #fffdfb;\n  box-shadow: 0 14px 35px #28252614;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  transform: translate(-50%, -4px);\n  transition: width 160ms cubic-bezier(.2,.8,.2,1), opacity 140ms cubic-bezier(.2,.8,.2,1),\n    transform 140ms cubic-bezier(.2,.8,.2,1), visibility 0s linear 140ms;\n}\n.gallery-mega.is-open { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); transition-delay: 0s; }\n.gallery-mega--brands { width: min(900px, calc(100vw - 36px)); }\n.gallery-mega--care { width: min(1000px, calc(100vw - 36px)); }\n.gallery-mega--skin { width: min(870px, calc(100vw - 36px)); }\n.gallery-mega--routines { width: min(960px, calc(100vw - 36px)); }\n.gallery-mega-inner { opacity: 1; transition: opacity 70ms ease; }\n.gallery-mega.is-switching .gallery-mega-inner { opacity: 0; }\n.gallery-mega-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-bottom: 15px; border-bottom: 1px solid #eee7e2; }\n.gallery-mega-heading > span { color: var(--rose); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.gallery-mega-heading a, .gallery-mega-feature b { display: inline-flex; align-items: center; gap: 7px; color: var(--rose); font-size: 12px; font-weight: 600; white-space: nowrap; }\n.gallery-mega-heading a:hover, .gallery-mega-feature:hover b { text-decoration: underline; text-underline-offset: 3px; }\n.gallery-mega-group h2 { margin: 0 0 11px; color: #9d596b; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.gallery-mega-links a { display: block; width: fit-content; min-height: 30px; padding: 5px 0; color: var(--ink); font-size: 13px; line-height: 20px; }\n.gallery-mega-links a:hover, .gallery-mega-links a:focus-visible { color: var(--rose); }\n.gallery-brands-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 27px; padding-top: 20px; }\n.gallery-brand-columns { display: grid; grid-auto-flow: column; grid-template-rows: repeat(var(--brand-rows-desktop), minmax(40px, auto)); grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px 11px; }\n.gallery-brand-columns a { width: auto; min-height: 40px; display: flex; align-items: center; padding: 7px 12px; border: 1px solid #e9e0dc; background: #fffdfb; white-space: nowrap; transition: border-color 140ms ease, background-color 140ms ease, color 140ms ease; }\n.gallery-brand-columns a:hover, .gallery-brand-columns a:focus-visible { border-color: #c999a7; background: #fcf3f4; }\n.gallery-mega-feature { min-height: 174px; display: flex; flex-direction: column; align-items: flex-start; padding: 19px 18px; background: #f9eff0; }\n.gallery-mega-feature > span { color: #9d596b; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.gallery-mega-feature > strong { margin-top: 16px; color: var(--ink); font-family: var(--serif); font-size: 23px; font-weight: 500; line-height: 1.15; }\n.gallery-mega-feature > small { margin-top: 8px; color: #6e6064; font-size: 11px; line-height: 1.5; }\n.gallery-mega-feature > b { margin-top: auto; padding-top: 14px; }\n.gallery-care-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 54px; padding: 24px 0 20px; }\n.gallery-mega-quick { display: flex; align-items: center; gap: 25px; padding-top: 15px; border-top: 1px solid #eee7e2; }\n.gallery-mega-quick span { color: #9d596b; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.gallery-mega-quick a { color: var(--ink); font-size: 12px; }\n.gallery-mega-quick a:hover { color: var(--rose); }\n.gallery-skin-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 28px; padding-top: 22px; }\n.gallery-skin-grid > section { padding: 16px 10px; }\n.gallery-skin-needs { padding: 16px 24px !important; background: #fcf4f4; }\n.gallery-skin-needs .gallery-mega-links { columns: 2; column-gap: 20px; }\n.gallery-skin-needs .gallery-mega-links a { break-inside: avoid; }\n.gallery-routine-grid { display: grid; grid-template-columns: 1fr 1fr 235px; gap: 45px; padding-top: 23px; }\n.gallery-routine-grid .gallery-mega-feature { min-height: 192px; }\n.gallery-routine-grid .gallery-mega-feature > svg { color: var(--rose); margin-bottom: 8px; }\n.gallery-routine-grid .gallery-mega-feature > strong { margin-top: 11px; }\n\n@media (max-width: 1050px) {\n  .gallery-routine-grid { grid-template-columns: 1fr 1fr 200px; gap: 24px; }\n}\n@media (max-width: 850px) {\n  .gallery-mega { padding-inline: 24px; }\n  .gallery-brand-columns { grid-template-rows: repeat(var(--brand-rows-compact), minmax(40px, auto)); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .gallery-care-grid { gap: 22px; }\n  .gallery-skin-needs .gallery-mega-links { columns: 1; }\n  .gallery-routine-grid { grid-template-columns: 1fr 1fr; }\n  .gallery-routine-grid .gallery-mega-feature { display: none; }\n}\n@media (max-width: 760px) {\n  .gallery-nav-system { display: none; }\n  .gallery-mobile-link, .gallery-mobile-trigger { min-height: 49px; margin: 0 22px; display: flex; align-items: center; justify-content: space-between; border: 0; border-bottom: 1px solid #eee9e4; background: transparent; color: var(--ink); font-size: 13px; text-align: left; }\n  .gallery-mobile-link > svg { color: #89797d; }\n  .gallery-mobile-accordion { margin: 0 22px; border-bottom: 1px solid #eee9e4; }\n  .gallery-mobile-trigger { width: 100%; margin: 0; border-bottom: 0; cursor: pointer; }\n  .gallery-mobile-trigger svg { color: #89797d; transition: transform 140ms cubic-bezier(.2,.8,.2,1); }\n  .gallery-mobile-accordion.is-open .gallery-mobile-trigger svg { transform: rotate(180deg); color: var(--rose); }\n  .gallery-mobile-panel { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 160ms cubic-bezier(.2,.8,.2,1), opacity 140ms ease; }\n  .gallery-mobile-accordion.is-open .gallery-mobile-panel { grid-template-rows: 1fr; opacity: 1; }\n  .gallery-mobile-panel-inner { min-height: 0; overflow: hidden; padding-left: 14px; }\n  .gallery-mobile-panel section { margin: 9px 0 15px; }\n  .gallery-mobile-panel h3 { margin: 0 0 4px; color: var(--rose); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n  .gallery-mobile-panel section a { display: block; padding: 7px 0; color: var(--ink); font-size: 12px; }\n  .gallery-mobile-brand-all { display: flex; align-items: center; justify-content: flex-end; gap: 6px; padding: 8px 0 12px; color: var(--rose); font-size: 11px; font-weight: 700; }\n  .gallery-mobile-brand-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding-bottom: 16px; }\n  .gallery-mobile-brand-links a { min-height: 40px; display: flex; align-items: center; padding: 8px 10px; border: 1px solid #e9e0dc; background: #fffdfb; color: var(--ink); font-size: 11px; line-height: 1.25; }\n  .gallery-mobile-brand-links a:hover { border-color: #c999a7; background: #fcf3f4; color: var(--rose); }\n  .gallery-mobile-panel section a:hover { color: var(--rose); }\n  .gallery-mobile-all { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 17px; padding-top: 9px; border-top: 1px solid #eee9e4; color: var(--rose); font-size: 12px; font-weight: 600; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .gallery-mega, .gallery-mega-inner, .gallery-nav-chevron svg, .gallery-mobile-trigger svg, .gallery-mobile-panel { transition-duration: .01ms; }\n}\n"]],"\n\n",["BODY",{},"\n  ",["DIV",{"id":"root"},["DIV",{"class":"site-shell"},["HEADER",{"class":"site-header "},["DIV",{"class":"header-main"},["BUTTON",{"class":"icon-button mobile-menu-toggle","aria-label":"Ouvrir le menu"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"23","height":"23","fill":"currentColor","viewBox":"0 0 256 256"},["path",{"d":"M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"}]]],["A",{"class":"logo-link"