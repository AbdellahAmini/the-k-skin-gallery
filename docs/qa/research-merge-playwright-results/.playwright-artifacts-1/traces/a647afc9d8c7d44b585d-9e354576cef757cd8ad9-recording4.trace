{"type":"frame-snapshot","snapshot":{"callId":"call@205","phase":"after","pageId":"page@2d3b00ad4d395eb30079df003ea0d087","frameId":"frame@c62e000c70aa56c500190382955c51a6","frameUrl":"http://127.0.0.1:5173/","doctype":"html","html":["HTML",{"lang":"fr"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:5173/"}],"\n  ","\n\n  ","\n\n  ",["META",{"charset":"utf-8"}],"\n  ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n  ",["LINK",{"rel":"icon","type":"image/svg+xml","href":"/favicon.svg"}],"\n  ",["META",{"name":"theme-color","content":"#f7f6f3"}],"\n  ",["META",{"name":"description","content":"Découvrez une sélection de soins coréens authentiques, livrés partout au Maroc. Paiement à la livraison."}],"\n  ",["TITLE",{},"K-Skin Gallery — Korean Skincare au Maroc"],"\n",["STYLE",{},"@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap');\n\n:root {\n  font-family: 'DM Sans', Arial, sans-serif;\n  color: #282526;\n  background: #f7f6f3;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  --gallery-white: #f7f6f3;\n  --canvas: #efeae3;\n  --blush: #f1cdd5;\n  --petal: #fcebed;\n  --ink: #282526;\n  --rose: #a7546b;\n  --line: #e6e0da;\n  --serif: 'Playfair Display', Georgia, serif;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  scroll-padding-top: 25px;\n}\n\nbody {\n  margin: 0;\n  min-width: 320px;\n  min-height: 100vh;\n  background: var(--gallery-white);\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\nbutton {\n  color: inherit;\n}\n\nbutton:focus-visible,\na:focus-visible,\ninput:focus-visible {\n  outline: 2px solid var(--rose);\n  outline-offset: 3px;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\n.site-shell {\n  width: 100%;\n  overflow-x: clip;\n}\n\n.trust-bar {\n  height: 35px;\n  background: #f6e7e9;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(22px, 6.2vw, 98px);\n  color: #51464a;\n  font-size: 11px;\n  letter-spacing: .01em;\n}\n\n.trust-item {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  white-space: nowrap;\n}\n\n.trust-item svg {\n  color: var(--rose);\n}\n\n.trust-divider {\n  width: 1px;\n  height: 16px;\n  background: #d7c5c8;\n}\n\n.site-header {\n  position: relative;\n  z-index: 5;\n  background: #fffdfa;\n}\n\n.header-main {\n  max-width: 1440px;\n  height: 105px;\n  padding: 8px 4.3%;\n  margin: auto;\n  display: grid;\n  grid-template-columns: 265px minmax(280px, 1fr) 285px;\n  align-items: center;\n  gap: clamp(22px, 4vw, 62px);\n}\n\n.logo-link {\n  display: block;\n  width: 255px;\n  line-height: 0;\n}\n\n.brand-logo {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.search-wrap {\n  height: 45px;\n  position: relative;\n  display: flex;\n  align-items: center;\n  background: #fff;\n  border: 1px solid #e2ded9;\n  border-radius: 5px;\n}\n\n.search-wrap:focus-within {\n  border-color: #b77b8b;\n  box-shadow: 0 0 0 2px #a7546b14;\n}\n\n.search-icon {\n  margin-left: 15px;\n  flex: 0 0 auto;\n  color: var(--ink);\n}\n\n.search-wrap input {\n  min-width: 0;\n  flex: 1;\n  height: 100%;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  padding: 0 13px;\n  color: var(--ink);\n  font-size: 12px;\n}\n\n.search-wrap input::placeholder {\n  color: #797478;\n}\n\n.search-clear {\n  border: 0;\n  background: transparent;\n  cursor: pointer;\n  margin-right: 11px;\n  color: #746b6c;\n  display: inline-flex;\n}\n\n.search-popover,\n.nav-popover {\n  position: absolute;\n  top: calc(100% + 7px);\n  left: 0;\n  z-index: 12;\n  width: 100%;\n  padding: 13px 15px;\n  background: #fffdfa;\n  border: 1px solid var(--line);\n  box-shadow: 0 10px 24px #28252612;\n}\n\n.popover-label {\n  display: block;\n  color: var(--rose);\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: .12em;\n  margin: 0 0 6px;\n}\n\n.search-popover button {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  width: 100%;\n  border: 0;\n  border-top: 1px solid #eee9e4;\n  padding: 10px 2px;\n  background: transparent;\n  text-align: left;\n  cursor: pointer;\n  font-size: 12px;\n}\n\n.search-popover button span {\n  color: #857c7e;\n  font-size: 10px;\n  margin-bottom: 2px;\n}\n\n.search-popover p {\n  margin: 8px 0 2px;\n  color: #6b6466;\n  font-size: 12px;\n}\n\n.header-actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 13px;\n  height: 100%;\n  align-items: center;\n}\n\n.header-action {\n  position: relative;\n  min-width: 62px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  border: 0;\n  padding: 8px 2px;\n  background: transparent;\n  color: var(--ink);\n  cursor: pointer;\n  font-size: 10px;\n  white-space: nowrap;\n}\n\n.header-action svg {\n  stroke-width: 1.6;\n}\n\n.header-action small,\n.bag-wrap small {\n  position: absolute;\n  top: 0;\n  right: 5px;\n  width: 17px;\n  height: 17px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: var(--rose);\n  color: white;\n  font-size: 9px;\n}\n\n.bag-wrap {\n  position: relative;\n  display: inline-flex;\n}\n\n.mobile-menu-toggle,\n.mobile-search {\n  display: none;\n}\n\n.primary-nav {\n  min-height: 39px;\n  max-width: 1440px;\n  margin: auto;\n  padding: 0 4.5% 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(21px, 3vw, 45px);\n}\n\n.primary-nav button {\n  position: relative;\n  border: 0;\n  padding: 5px 0 7px;\n  background: transparent;\n  text-transform: none;\n  cursor: pointer;\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.primary-nav button::after {\n  content: '';\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 0;\n  height: 1px;\n  background: var(--rose);\n  transition: width .18s ease;\n}\n\n.primary-nav button:hover::after,\n.primary-nav button.active::after {\n  width: 100%;\n}\n\n.nav-popover {\n  top: 100%;\n  left: auto;\n  right: 4.5%;\n  width: min(420px, 92vw);\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px 17px;\n  padding: 19px 22px;\n}\n\n.nav-popover button {\n  padding: 8px 0;\n  border: 0;\n  background: transparent;\n  cursor: pointer;\n  font-size: 12px;\n}\n\n.nav-popover .rose-link {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--rose);\n  border-top: 1px solid var(--line);\n  margin-top: 5px;\n  padding-top: 14px;\n}\n\n/* ============================================================\n   HERO CAROUSEL — Redesigned Component System\n   ============================================================ */\n\n.hero-carousel-container {\n  position: relative;\n  width: 100%;\n  height: clamp(560px, 48vw, 640px);\n  min-height: 520px;\n  max-height: 640px;\n  display: flex;\n  align-items: center;\n  background: #f7f6f3;\n  overflow: hidden;\n  outline: none;\n}\n\n.hero-slides-viewport {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  z-index: 0;\n}\n\n.hero-slide {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  opacity: 0;\n  pointer-events: none;\n  visibility: hidden;\n  transform: translate3d(100%, 0, 0);\n  transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1),\n    opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),\n    visibility 800ms cubic-bezier(0.22, 1, 0.36, 1);\n  will-change: transform, opacity;\n}\n\n.hero-carousel-container.dir-prev .hero-slide {\n  transform: translate3d(-100%, 0, 0);\n}\n\n.hero-slide.active {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  transform: translate3d(0%, 0, 0) !important;\n  z-index: 2;\n}\n\n.hero-slide.exiting {\n  opacity: 0.98;\n  visibility: visible;\n  transform: translate3d(-100%, 0, 0);\n  z-index: 1;\n}\n\n.hero-carousel-container.dir-prev .hero-slide.exiting {\n  transform: translate3d(100%, 0, 0);\n}\n\n.hero-picture-wrap {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.hero-slide-image {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: var(--focal-desktop, 68% 50%);\n  transform: scale(1.01) translate3d(0, 0, 0);\n  transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);\n  will-change: transform;\n}\n\n.hero-slide.active .hero-slide-image {\n  transform: scale(1) translate3d(0, 0, 0);\n}\n\n.hero-slide.exiting .hero-slide-image {\n  transform: scale(0.995) translate3d(0, 0, 0);\n}\n\n/* Subtle readability gradient over image */\n\n.hero-gradient-overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  pointer-events: none;\n  background: linear-gradient(90deg,\n      rgba(247, 246, 243, 0.94) 0%,\n      rgba(247, 246, 243, 0.18) 36%,\n      rgba(247, 246, 243, 0.02) 64%,\n      transparent 84%);\n}\n\n/* HTML Copy Overlay */\n\n.hero-copy-overlay {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  max-width: var(--container, 1320px);\n  margin: 0 auto;\n  padding: 0 4.5%;\n  pointer-events: none;\n}\n\n.hero-copy-content {\n  pointer-events: auto;\n  max-width: 480px;\n}\n\n.hero-copy-content.animate-copy {\n  animation: heroCopyTransition 400ms cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n@keyframes heroCopyTransition {\n  from {\n    opacity: 0;\n    transform: translate3d(0, 7px, 0);\n  }\n\n  to {\n    opacity: 1;\n    transform: translate3d(0, 0, 0);\n  }\n}\n\n.eyebrow {\n  margin: 0;\n  color: #55484a;\n  font-size: 9.5px;\n  font-weight: 600;\n  letter-spacing: 0.22em;\n  line-height: 1.5;\n  text-transform: uppercase;\n}\n\n.hero-copy-content h1 {\n  margin: 16px 0 14px;\n  font-family: var(--serif);\n  font-size: clamp(38px, 4.4vw, 56px);\n  font-weight: 500;\n  line-height: 1.05;\n  letter-spacing: -0.035em;\n  color: #1f1b1c;\n}\n\n.hero-intro {\n  max-width: 440px;\n  margin: 0 0 24px;\n  font-size: 14.5px;\n  line-height: 1.55;\n  color: #484144;\n}\n\n.hero-actions {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.hero-cta,\n.hero-cta-secondary {\n  min-height: 46px;\n  padding: 0 18px;\n  border-radius: 4px;\n  border: 1px solid rgba(177, 85, 109, 0.65);\n  color: var(--rose);\n  background: rgba(255, 255, 255, 0.9);\n  backdrop-filter: blur(6px);\n  font-size: 13px;\n  font-weight: 600;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  transition: background 180ms ease, color 180ms ease, border-color 180ms ease;\n}\n\n.hero-cta:hover,\n.hero-cta-secondary:hover {\n  background: var(--rose);\n  border-color: var(--rose);\n  color: #ffffff;\n}\n\n.hero-cta svg,\n.hero-cta-secondary svg {\n  transition: transform 180ms ease;\n}\n\n.hero-cta:hover svg,\n.hero-cta-secondary:hover svg {\n  transform: translate3d(3px, 0, 0);\n}\n\n/* Minimal Centered Dot Indicators inside Hero Image */\n\n/* =========================================================\n   HERO INDICATORS — stable dot → pill morph\n   ========================================================= */\n\n.hero-indicators {\n  position: absolute;\n  z-index: 3;\n  left: 50%;\n  bottom: 20px;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  padding: 5px 7px;\n  gap: 2px;\n\n  transform: translate3d(-50%, 0, 0);\n\n  border: 1px solid rgba(255, 255, 255, 0.16);\n  border-radius: 999px;\n\n  background: rgba(40, 37, 38, 0.20);\n\n  box-shadow:\n    0 2px 12px rgba(40, 37, 38, 0.08);\n\n  pointer-events: auto;\n}\n\n/* Large invisible interaction area */\n\n.hero-dot-btn {\n  width: 38px;\n  height: 24px;\n\n  display: grid;\n  place-items: center;\n\n  padding: 0;\n  border: 0;\n  background: transparent;\n\n  cursor: pointer;\n}\n\n/* The visible indicator */\n\n.hero-dot-pill {\n  display: block;\n\n  width: 8px;\n  height: 8px;\n\n  flex: 0 0 auto;\n\n  border: 0;\n  border-radius: 999px;\n\n  background: rgba(255, 255, 255, 0.52);\n\n  box-shadow:\n    0 1px 4px rgba(40, 37, 38, 0.14);\n\n  opacity: 0.82;\n\n  transition:\n    width 260ms cubic-bezier(0.22, 1, 0.36, 1),\n    opacity 220ms ease,\n    background-color 220ms ease,\n    box-shadow 220ms ease,\n    transform 220ms cubic-bezier(0.22, 1, 0.36, 1);\n}\n\n/* Hover inactive indicators */\n\n.hero-dot-btn:hover .hero-dot-pill {\n  background: rgba(255, 255, 255, 0.82);\n  opacity: 1;\n  transform: scale(1.08);\n}\n\n/* Active = permanent capsule */\n\n.hero-dot-btn.active .hero-dot-pill {\n  width: 30px;\n\n  background: rgba(255, 255, 255, 0.98);\n\n  opacity: 1;\n\n  transform: scale(1);\n\n  box-shadow:\n    0 1px 6px rgba(40, 37, 38, 0.18);\n}\n\n/* Don't draw a huge focus ring around the 38px hit area */\n\n.hero-dot-btn:focus-visible {\n  outline: none;\n}\n\n/* Focus the actual visual indicator instead */\n\n.hero-dot-btn:focus-visible .hero-dot-pill {\n  box-shadow:\n    0 0 0 2px rgba(167, 84, 107, 0.75),\n    0 1px 6px rgba(40, 37, 38, 0.18);\n}\n\n@media (max-width: 768px) {\n  .hero-indicators {\n    bottom: 14px;\n    padding: 4px 6px;\n  }\n\n  .hero-dot-btn {\n    width: 36px;\n    height: 34px;\n  }\n\n  .hero-dot-pill {\n    width: 7px;\n    height: 7px;\n  }\n\n  .hero-dot-btn.active .hero-dot-pill {\n    width: 26px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hero-dot-pill {\n    transition: none;\n  }\n}\n\n/* ============================================================\n   HOMEPAGE KOREAN BRANDS MARQUEE (The K-Skin Gallery)\n   ============================================================ */\n\n.home-brands {\n  position: relative;\n  background: #fffdfb;\n  border-bottom: 1px solid rgba(40, 37, 38, 0.07);\n  padding: 30px 0 22px;\n  overflow: hidden;\n  width: 100%;\n}\n\n.home-brands__header {\n  max-width: 1440px;\n  margin: 0 auto;\n  padding: 0 clamp(16px, 4.5vw, 48px);\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 22px;\n}\n\n.home-brands__title-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.home-brands__eyebrow {\n  display: block;\n  font-family: 'DM Sans', sans-serif;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--rose, #a7546b);\n  margin-bottom: 5px;\n}\n\n.home-brands__heading {\n  margin: 0;\n  font-family: var(--serif, 'Playfair Display', Georgia, serif);\n  font-size: clamp(24px, 2.5vw, 32px);\n  font-weight: 500;\n  color: var(--ink, #282526);\n  line-height: 1.15;\n  display: inline-flex;\n  align-items: center;\n}\n\n.home-brands__heading-accent {\n  display: inline-block;\n  width: 3px;\n  height: 0.76em;\n  background: var(--rose, #a7546b);\n  margin-right: 11px;\n  border-radius: 1.5px;\n}\n\n.home-brands__cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-family: 'DM Sans', sans-serif;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--rose, #a7546b);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: transform 180ms ease, color 180ms ease;\n  padding-bottom: 2px;\n}\n\n.home-brands__cta:hover {\n  transform: translateX(2px);\n  color: #8c3f55;\n}\n\n.home-brands__cta-text-short {\n  display: none;\n}\n\n.home-brands__marquee {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  -webkit-mask-image: linear-gradient(\n    to right,\n    transparent 0%,\n    black 6%,\n    black 94%,\n    transparent 100%\n  );\n  mask-image: linear-gradient(\n    to right,\n    transparent 0%,\n    black 6%,\n    black 94%,\n    transparent 100%\n  );\n}\n\n.home-brands__marquee-track {\n  display: flex;\n  width: max-content;\n  will-change: transform;\n  animation: brands-infinite-marquee 54s linear infinite;\n}\n\n.home-brands__marquee-track:focus-within {\n  animation-play-state: paused;\n}\n\n.home-brands__marquee-group {\n  display: flex;\n  align-items: center;\n  gap: clamp(54px, 5.5vw, 84px);\n  padding-right: clamp(54px, 5.5vw, 84px);\n  flex-shrink: 0;\n}\n\n.home-brands__logo-item {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: clamp(120px, 10vw, 170px);\n  height: 64px;\n  flex-shrink: 0;\n  text-decoration: none;\n  opacity: 0.78;\n  transition: opacity 180ms ease, transform 180ms ease;\n}\n\n.home-brands__logo-item:hover {\n  opacity: 1;\n  transform: translateY(-2px);\n}\n\n.home-brands__logo-item:focus-visible {\n  opacity: 1;\n  outline: 2px solid var(--rose, #a7546b);\n  outline-offset: 4px;\n  border-radius: 4px;\n}\n\n.home-brands__logo-slot {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n}\n\n.home-brands__logo-img {\n  max-width: 100%;\n  max-height: 38px;\n  width: auto;\n  height: auto;\n  object-fit: contain;\n  display: block;\n  user-select: none;\n  pointer-events: none;\n}\n\n.home-brands__logo-fallback {\n  font-family: var(--serif, 'Playfair Display', Georgia, serif);\n  font-size: 15px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--ink, #282526);\n  white-space: nowrap;\n  user-select: none;\n}\n\n@keyframes brands-infinite-marquee {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n@media (max-width: 768px) {\n  .home-brands {\n    padding: 24px 0 18px;\n  }\n\n  .home-brands__header {\n    margin-bottom: 16px;\n    align-items: flex-end;\n  }\n\n  .home-brands__heading {\n    font-size: clamp(20px, 5.5vw, 26px);\n  }\n\n  .home-brands__cta-text-full {\n    display: none;\n  }\n\n  .home-brands__cta-text-short {\n    display: inline;\n  }\n\n  .home-brands__marquee-track {\n    animation-duration: 36s;\n  }\n\n  .home-brands__marquee-group {\n    gap: clamp(38px, 9vw, 56px);\n    padding-right: clamp(38px, 9vw, 56px);\n  }\n\n  .home-brands__logo-item {\n    width: clamp(96px, 24vw, 130px);\n    height: 52px;\n  }\n\n  .home-brands__logo-img {\n    max-height: 32px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .home-brands__marquee-track {\n    animation: none;\n    transform: none;\n  }\n\n  .home-brands__marquee {\n    overflow-x: auto;\n    -webkit-mask-image: none;\n    mask-image: none;\n  }\n\n  .home-brands__marquee-group[aria-hidden=\"true\"] {\n    display: none;\n  }\n}\n\n.text-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  flex: 0 0 auto;\n  border: 0;\n  padding: 7px 0;\n  background: transparent;\n  color: var(--rose);\n  cursor: pointer;\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.text-link:hover {\n  color: #803d52;\n}\n\n.selection-section {\n  max-width: 1440px;\n  margin: 0 auto;\n  padding: 19px 3.3% 28px;\n  scroll-margin-top: 20px;\n}\n\n.section-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  margin-bottom: 13px;\n}\n\n.section-eyebrow {\n  display: none;\n}\n\n.section-heading h2 {\n  margin: 0;\n  font-family: var(--serif);\n  font-size: 30px;\n  line-height: 1.13;\n  font-weight: 500;\n  letter-spacing: -.02em;\n}\n\n.section-heading .text-link {\n  margin-bottom: 1px;\n}\n\n.product-grid {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.product-card {\n  min-width: 0;\n  background: #fbfaf8;\n  border: 1px solid #f2efec;\n  transition: border-color .2s ease, transform .2s ease;\n}\n\n.product-card:hover {\n  border-color: #ddd2ce;\n  transform: translateY(-2px);\n}\n\n.product-image-area {\n  position: relative;\n  height: 183px;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  background: #fff;\n}\n\n.product-image-area img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  mix-blend-mode: multiply;\n}\n\n.product-note {\n  position: absolute;\n  left: 10px;\n  top: 9px;\n  max-width: 115px;\n  background: #f7e7e9;\n  padding: 5px 7px;\n  color: #76505b;\n  font-size: 8px;\n  letter-spacing: .02em;\n}\n\n.favorite-button {\n  position: absolute;\n  top: 7px;\n  right: 8px;\n  display: grid;\n  width: 31px;\n  height: 31px;\n  place-items: center;\n  border: 1px solid #eee8e4;\n  border-radius: 50%;\n  background: #fffdfa;\n  color: #675f61;\n  cursor: pointer;\n}\n\n.favorite-button:hover,\n.favorite-button.is-favorite {\n  color: var(--rose);\n  border-color: #dcbec6;\n}\n\n.product-info {\n  padding: 9px 11px 11px;\n}\n\n.product-brand {\n  margin: 0 0 4px;\n  color: #4b4346;\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.product-info h3 {\n  min-height: 34px;\n  margin: 0;\n  color: #282526;\n  font-size: 10px;\n  font-weight: 500;\n  line-height: 1.45;\n}\n\n.product-size {\n  margin: 3px 0 8px;\n  color: #837b7d;\n  font-size: 9px;\n}\n\n.product-buy {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 8px;\n}\n\n.product-buy strong {\n  color: var(--rose);\n  font-size: 14px;\n  font-weight: 700;\n}\n\n.add-button {\n  min-height: 31px;\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  border: 1px solid var(--rose);\n  border-radius: 3px;\n  background: var(--rose);\n  color: #fff;\n  cursor: pointer;\n  font-size: 9px;\n  font-weight: 600;\n}\n\n.add-button:hover {\n  background: #884459;\n}\n\n.empty-results {\n  grid-column: 1 / -1;\n  min-height: 180px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  color: #756d70;\n}\n\n.empty-results p {\n  margin: 0;\n  font-size: 13px;\n}\n\n.routine-band {\n  min-height: 174px;\n  padding: 25px 3.3%;\n  display: grid;\n  grid-template-columns: 1.38fr repeat(3, 1fr) .9fr;\n  align-items: center;\n  gap: 0;\n  background: #f8eaec;\n  border-top: 1px solid #f0e2e3;\n}\n\n.routine-intro {\n  padding-right: 18px;\n}\n\n.routine-intro .eyebrow {\n  font-size: 8px;\n  letter-spacing: .18em;\n}\n\n.routine-intro h2 {\n  margin: 6px 0 5px;\n  font-family: var(--serif);\n  font-size: clamp(20px, 2.05vw, 28px);\n  font-weight: 500;\n  letter-spacing: -.025em;\n  line-height: 1.1;\n}\n\n.routine-intro>p:last-child {\n  margin: 0;\n  color: #595154;\n  font-size: 11px;\n}\n\n.routine-step {\n  position: relative;\n  min-height: 72px;\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 1px clamp(10px, 1.6vw, 24px);\n  border-left: 1px solid #d8c5c8;\n}\n\n.routine-step>span {\n  width: 30px;\n  height: 30px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: var(--rose);\n  color: white;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.routine-step h3 {\n  margin: 1px 0 6px;\n  font-family: var(--serif);\n  font-size: 16px;\n  font-weight: 500;\n}\n\n.routine-step p {\n  max-width: 150px;\n  margin: 0;\n  color: #62595b;\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n.step-sparkle {\n  position: absolute;\n  right: 10px;\n  bottom: 1px;\n  color: #c9b7a6;\n}\n\n.routine-cta {\n  justify-self: end;\n  white-space: nowrap;\n  font-size: 10px;\n  padding: 0 14px;\n}\n\n.bottom-trust {\n  min-height: 76px;\n  padding: 14px 4.5%;\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  align-items: center;\n  gap: 15px;\n  background: #fffdfa;\n}\n\n.bottom-trust>div {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 8px;\n  color: #595154;\n  font-size: 10px;\n}\n\n.bottom-trust svg {\n  color: var(--rose);\n}\n\n.site-footer {\n  padding: 20px 5% 22px;\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  border-top: 1px solid var(--line);\n  background: #f4f0ec;\n  color: #6d6566;\n  font-size: 10px;\n}\n\n.footer-brand {\n  width: 150px;\n  line-height: 0;\n}\n\n.footer-brand img {\n  width: 100%;\n}\n\n.site-footer>span {\n  flex: 1;\n}\n\n.site-footer>div {\n  display: flex;\n  gap: 18px;\n}\n\n.site-footer>div button {\n  border: 0;\n  background: transparent;\n  padding: 0;\n  color: inherit;\n  cursor: pointer;\n  font-size: inherit;\n}\n\n.site-footer>small {\n  white-space: nowrap;\n}\n\n.mobile-tabbar {\n  display: none;\n}\n\n.overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 30;\n  display: flex;\n  justify-content: flex-end;\n  background: #211c1d66;\n}\n\n.cart-drawer,\n.mobile-drawer {\n  width: min(455px, 100%);\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  background: #fffdfa;\n  box-shadow: -8px 0 35px #1c151420;\n  animation: slide-in .22s ease-out;\n}\n\n@keyframes slide-in {\n  from {\n    transform: translateX(20px);\n    opacity: .7;\n  }\n\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n\n.drawer-head {\n  min-height: 74px;\n  padding: 16px 22px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--line);\n}\n\n.drawer-head>div {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.drawer-head span {\n  font-family: var(--serif);\n  font-size: 21px;\n}\n\n.drawer-head small {\n  color: #746c6e;\n  font-size: 10px;\n}\n\n.drawer-head>button {\n  display: grid;\n  width: 36px;\n  height: 36px;\n  place-items: center;\n  border: 1px solid var(--line);\n  border-radius: 50%;\n  background: transparent;\n  cursor: pointer;\n}\n\n.cart-lines {\n  flex: 1;\n  overflow-y: auto;\n  padding: 5px 22px;\n}\n\n.cart-line {\n  display: grid;\n  grid-template-columns: 82px 1fr auto;\n  gap: 12px;\n  align-items: center;\n  padding: 15px 0;\n  border-bottom: 1px solid #eee9e4;\n}\n\n.cart-line>img {\n  width: 82px;\n  height: 100px;\n  object-fit: contain;\n  background: white;\n  mix-blend-mode: multiply;\n}\n\n.cart-line-copy {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.cart-line-copy strong {\n  font-size: 11px;\n}\n\n.cart-line-copy>span {\n  color: #494346;\n  font-size: 10px;\n  line-height: 1.4;\n}\n\n.cart-line-copy>small {\n  color: #82797b;\n  font-size: 9px;\n}\n\n.cart-line>b {\n  align-self: start;\n  padding-top: 3px;\n  color: var(--rose);\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.quantity-control {\n  width: fit-content;\n  margin-top: 4px;\n  display: flex;\n  align-items: center;\n  border: 1px solid #ded8d3;\n}\n\n.quantity-control button {\n  width: 27px;\n  height: 25px;\n  display: grid;\n  place-items: center;\n  border: 0;\n  background: transparent;\n  cursor: pointer;\n}\n\n.quantity-control span {\n  min-width: 25px;\n  text-align: center;\n  font-size: 10px;\n}\n\n.cart-summary {\n  padding: 18px 22px 25px;\n  border-top: 1px solid var(--line);\n}\n\n.cart-summary>p,\n.checkout-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin: 0 0 7px;\n  font-size: 13px;\n}\n\n.cart-summary>p strong,\n.checkout-total strong {\n  color: var(--rose);\n  font-size: 16px;\n}\n\n.cart-summary>small {\n  color: #756c6e;\n  font-size: 10px;\n}\n\n.checkout-button {\n  width: 100%;\n  justify-content: space-between;\n  margin-top: 18px;\n}\n\n.cod-note {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  margin-top: 12px;\n  color: #62595b;\n  font-size: 10px;\n}\n\n.cart-empty {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 30px;\n  text-align: center;\n  color: #726a6c;\n}\n\n.cart-empty>svg {\n  color: var(--rose);\n}\n\n.cart-empty h3 {\n  margin: 13px 0 4px;\n  color: var(--ink);\n  font-family: var(--serif);\n  font-size: 22px;\n  font-weight: 500;\n}\n\n.cart-empty p {\n  max-width: 270px;\n  margin: 0 0 16px;\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n.mobile-drawer {\n  width: min(390px, 100%);\n  padding-bottom: 20px;\n}\n\n.mobile-drawer>button {\n  min-height: 49px;\n  margin: 0 22px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border: 0;\n  border-bottom: 1px solid #eee9e4;\n  background: transparent;\n  text-align: left;\n  cursor: pointer;\n  font-size: 13px;\n}\n\n.checkout-overlay {\n  justify-content: center;\n  align-items: center;\n  padding: 20px;\n}\n\n.checkout-modal {\n  width: min(560px, 100%);\n  max-height: min(90vh, 820px);\n  overflow-y: auto;\n  background: #fffdfa;\n  box-shadow: 0 15px 45px #211c1d30;\n}\n\n.checkout-form {\n  padding: 18px 24px 24px;\n}\n\n.checkout-form>p {\n  margin: 0 0 14px;\n  font-family: var(--serif);\n  font-size: 19px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n\n.form-grid label {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  color: #4e4749;\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.form-grid label small {\n  display: inline;\n  color: #81787a;\n  font-weight: 400;\n}\n\n.form-grid input {\n  width: 100%;\n  height: 39px;\n  padding: 0 11px;\n  border: 1px solid #ded8d3;\n  border-radius: 3px;\n  background: white;\n  font-size: 11px;\n}\n\n.full-field {\n  grid-column: 1 / -1;\n}\n\n.checkout-total {\n  margin-top: 19px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n  font-size: 11px;\n}\n\n.checkout-privacy {\n  display: block;\n  margin-top: 10px;\n  color: #746c6e;\n  text-align: center;\n  font-size: 9px;\n}\n\n.order-success {\n  padding: 35px 35px 40px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n\n.success-mark {\n  width: 58px;\n  height: 58px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: #e7efe8;\n  color: #496a52;\n}\n\n.order-success h2 {\n  margin: 17px 0 7px;\n  font-family: var(--serif);\n  font-size: 30px;\n  font-weight: 500;\n}\n\n.order-success p {\n  max-width: 380px;\n  margin: 0 0 20px;\n  color: #645c5e;\n  font-size: 12px;\n  line-height: 1.6;\n}\n\n.toast {\n  position: fixed;\n  z-index: 40;\n  right: 22px;\n  bottom: 22px;\n  max-width: min(400px, calc(100% - 30px));\n  min-height: 46px;\n  padding: 10px 12px;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  background: #282526;\n  color: white;\n  box-shadow: 0 8px 22px #17131425;\n  font-size: 11px;\n  animation: toast-in .18s ease-out;\n}\n\n@keyframes toast-in {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.toast>svg {\n  color: #eccbd2;\n}\n\n.toast button {\n  display: grid;\n  place-items: center;\n  margin-left: 7px;\n  border: 0;\n  background: transparent;\n  color: white;\n  cursor: pointer;\n}\n\n@media (min-width: 1500px) {\n  .hero-copy {\n    padding-left: calc((100vw - 1350px) / 2);\n  }\n}\n\n@media (max-width: 1100px) {\n  .header-main {\n    grid-template-columns: 195px minmax(220px, 1fr) 210px;\n    gap: 15px;\n    padding-inline: 3%;\n  }\n\n  .logo-link {\n    width: 190px;\n  }\n\n  .header-actions {\n    gap: 4px;\n  }\n\n  .primary-nav {\n    gap: clamp(13px, 2vw, 24px);\n    padding-top: 4px;\n  }\n\n  .primary-nav button {\n    font-size: 10px;\n  }\n\n  .hero-copy {\n    width: 51%;\n  }\n\n  .hero h1 {\n    font-size: clamp(42px, 4.8vw, 54px);\n  }\n\n  .hero-intro {\n    max-width: 340px;\n    font-size: 13px;\n  }\n\n  .hero-caption {\n    display: none;\n  }\n\n  .hero-promises {\n    gap: 10px;\n  }\n\n  .hero-promises b {\n    font-size: 9px;\n  }\n\n  .hero-promises small {\n    font-size: 8px;\n  }\n\n  .brand-strip {\n    gap: 12px;\n  }\n\n\n  .routine-band {\n    grid-template-columns: 1.2fr repeat(3, 1fr);\n    row-gap: 20px;\n  }\n\n  .routine-cta {\n    grid-column: 4;\n    grid-row: 2;\n  }\n\n  .site-footer {\n    flex-wrap: wrap;\n  }\n}\n\n@media (max-width: 760px) {\n  html {\n    scroll-padding-top: 15px;\n  }\n\n  .trust-bar {\n    height: 31px;\n    gap: 8px;\n    padding: 0 8px;\n    justify-content: space-around;\n    font-size: 9px;\n  }\n\n  .trust-item {\n    gap: 5px;\n  }\n\n  .trust-item svg {\n    width: 14px;\n    height: 14px;\n  }\n\n  .trust-item:nth-of-type(3) {\n    display: none;\n  }\n\n  .trust-divider:nth-of-type(2) {\n    display: none;\n  }\n\n  .header-main {\n    height: 67px;\n    display: flex;\n    justify-content: space-between;\n    gap: 8px;\n    padding: 5px 16px;\n  }\n\n  .mobile-menu-toggle {\n    display: grid;\n    flex: 0 0 auto;\n    width: 33px;\n    height: 38px;\n    place-items: center;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    cursor: pointer;\n  }\n\n  .logo-link {\n    width: 145px;\n    flex: 0 0 auto;\n  }\n\n  .header-main>.search-wrap {\n    display: none;\n  }\n\n  .header-actions {\n    height: auto;\n    gap: 3px;\n  }\n\n  .header-action {\n    min-width: 38px;\n    width: 38px;\n    height: 40px;\n    padding: 4px;\n  }\n\n  .header-action>span:not(.bag-wrap) {\n    display: none;\n  }\n\n  .header-action small,\n  .bag-wrap small {\n    top: -2px;\n    right: -2px;\n    width: 15px;\n    height: 15px;\n    font-size: 8px;\n  }\n\n  .header-action svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .mobile-search {\n    display: flex;\n    height: 40px;\n    margin: 0 15px 10px;\n  }\n\n  .mobile-search input {\n    font-size: 11px;\n  }\n\n  .mobile-search .search-icon {\n    width: 17px;\n    margin-left: 12px;\n  }\n\n  .primary-nav {\n    min-height: 0;\n    padding: 0 0 10px;\n    justify-content: flex-start;\n    overflow-x: auto;\n    gap: 21px;\n    scrollbar-width: none;\n  }\n\n  .primary-nav::-webkit-scrollbar {\n    display: none;\n  }\n\n  .primary-nav button {\n    padding: 4px 0;\n    font-size: 10px;\n  }\n\n  .primary-nav button:first-child {\n    margin-left: 16px;\n  }\n\n  .primary-nav button:last-child {\n    margin-right: 16px;\n  }\n\n  .nav-popover {\n    right: 12px;\n    width: calc(100% - 24px);\n  }\n\n  .brand-strip {\n    min-height: 60px;\n    padding: 12px 16px;\n    gap: 12px;\n    overflow: hidden;\n  }\n\n\n\n  .selection-section {\n    padding: 22px 15px 24px;\n  }\n\n  .section-heading {\n    align-items: end;\n    margin-bottom: 11px;\n  }\n\n  .section-eyebrow {\n    display: block;\n    margin-bottom: 3px;\n    font-size: 7px;\n    letter-spacing: .14em;\n  }\n\n  .section-heading h2 {\n    font-size: 24px;\n  }\n\n  .section-heading .text-link {\n    max-width: 112px;\n    gap: 4px;\n    padding-bottom: 3px;\n    font-size: 9px;\n    text-align: right;\n  }\n\n  .section-heading .text-link svg {\n    flex: 0 0 auto;\n    width: 13px;\n  }\n\n  .product-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px;\n  }\n\n  .product-card:last-of-type:nth-child(odd) {\n    grid-column: 1 / -1;\n  }\n\n  .product-image-area {\n    height: clamp(145px, 45vw, 205px);\n  }\n\n  .product-note {\n    left: 6px;\n    top: 6px;\n    max-width: 92px;\n    padding: 4px 5px;\n    font-size: 7px;\n  }\n\n  .favorite-button {\n    top: 5px;\n    right: 5px;\n    width: 27px;\n    height: 27px;\n  }\n\n  .favorite-button svg {\n    width: 16px;\n  }\n\n  .product-info {\n    padding: 8px;\n  }\n\n  .product-brand {\n    font-size: 9px;\n  }\n\n  .product-info h3 {\n    min-height: 42px;\n    font-size: 9px;\n  }\n\n  .product-size {\n    margin: 2px 0 7px;\n    font-size: 8px;\n  }\n\n  .product-buy {\n    gap: 7px;\n  }\n\n  .product-buy strong {\n    font-size: 12px;\n  }\n\n  .add-button {\n    min-height: 31px;\n    gap: 5px;\n    font-size: 8px;\n  }\n\n  .add-button svg {\n    width: 13px;\n  }\n\n  .routine-band {\n    padding: 24px 16px 22px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0;\n  }\n\n  .routine-intro {\n    grid-column: 1 / -1;\n    padding: 0 0 17px;\n  }\n\n  .routine-intro .eyebrow {\n    font-size: 7px;\n  }\n\n  .routine-intro h2 {\n    margin-top: 5px;\n    font-size: 26px;\n  }\n\n  .routine-intro>p:last-child {\n    font-size: 10px;\n  }\n\n  .routine-step {\n    min-height: 77px;\n    gap: 8px;\n    padding: 4px 7px 4px 0;\n  }\n\n  .routine-step:nth-of-type(3) {\n    border-left: 1px solid #d8c5c8;\n    padding-left: 10px;\n  }\n\n  .routine-step:nth-of-type(4) {\n    border-left: 0;\n  }\n\n  .routine-step>span {\n    width: 25px;\n    height: 25px;\n    font-size: 10px;\n  }\n\n  .routine-step h3 {\n    margin-bottom: 4px;\n    font-size: 13px;\n  }\n\n  