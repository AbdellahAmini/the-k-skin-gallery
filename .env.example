# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./gallery.db
AUTO_IMPORT_CATALOG=0
GALLERY_DEMO_STOCK=0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Build-time static rendering. Leave PUBLIC_SITE_URL empty until the public
# domain is known; setting it emits canonical URLs, robots.txt and sitemap.xml.
GALLERY_API_ORIGIN=http://127.0.0.1:8000
PUBLIC_SITE_URL=

# Optional order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PUBLIC_URL=http://localhost:5173/admin/commandes

# Catalog images: local or s3. AWS credentials are backend-only.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT_URL=
MEDIA_PUBLIC_BASE_URL=
