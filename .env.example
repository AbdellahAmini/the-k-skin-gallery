# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./gallery.db
AUTO_IMPORT_CATALOG=1
GALLERY_DEMO_STOCK=1
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Build-time static rendering. Leave PUBLIC_SITE_URL empty until the public
# domain is known; setting it emits canonical URLs, robots.txt and sitemap.xml.
GALLERY_API_ORIGIN=http://127.0.0.1:8000
PUBLIC_SITE_URL=

# Optional order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PUBLIC_URL=http://localhost:5173/admin/commandes
